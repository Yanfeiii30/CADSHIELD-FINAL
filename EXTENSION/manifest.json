{
  "manifest_version": 3,
  "name": "Cyber-Aggression Detector",
  "version": "1.0.0",
  "description": "Real-time cyber-aggression detection using Naive Bayes and VADER.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "web_accessible_resources": [
    {
      "resources": ["lib/vocab.json"],
      "matches": ["<all_urls>"]
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://messenger.com/*",
        "*://*.messenger.com/*",
        "*://web.whatsapp.com/*",
        "*://web.telegram.org/*",
        "*://telegram.org/*",
        "*://mail.google.com/*",
        "*://outlook.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*",
        "*://viber.com/*",
        "*://*.viber.com/*",
        "*://slack.com/*",
        "*://*.slack.com/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*",
        "*://claude.ai/*",
        "*://chat.openai.com/*",
        "*://gemini.google.com/*",
        "*://docs.google.com/*",
        "*://drive.google.com/*"
      ],
      "js": [
        "config.js",
        "modules/diagnostics.js",
        "lib/vader.js",
        "lib/naive_bayes.js",
        "modules/detection_policy.js",
        "modules/page_rules.js",
        "modules/detection_log.js",
        "modules/algorithm_selector.js",
        "modules/custom_filter.js",
        "modules/result_display.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "assets/icon16.png",
      "48":  "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },

  "icons": {
    "16":  "assets/icon16.png",
    "48":  "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
